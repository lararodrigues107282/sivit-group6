# =============================================================================
# Boas, este é um exemplo do ficheiro .env que devem criar/editar antes de começarem a trabalhar.
#
# Como usar:
#    Copiar o BLOCO NO FIM DESTE FICHEIRO para um ficheiro .env na raiz do
#    repositório (ou copiar o ficheiro inteiro: as explicações são comentários);
# 
# IMPORTANTE: O .env verdadeiro *NUNCA* vai para o Git (já está no .gitignore).
#
# Depois de mudar um valor, recriar o serviço afetado para ele o ler:
#   docker compose up -d <serviço>
# =============================================================================

# -----------------------------------------------------------------------------
# Segredos (não podem ser partilhados: cada pessoa gera os seus)
# -----------------------------------------------------------------------------

# POSTGRES_PASSWORD
#   Palavra-passe do PostgreSQL. Inventar uma, por exemplo com:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
#   ATENÇÃO: só é aplicada quando o volume da base de dados é criado pela 1.ª vez.
#   Para a mudar depois é preciso apagar o volume (docker compose down -v),
#   o que APAGA TODOS OS DADOS.

# DJANGO_SECRET_KEY
#   Chave secreta do Django (assina sessões e tokens CSRF). Gerar com:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
#   Sem Python instalado no PC, o mesmo dentro de um contentor:
#     docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"

# PORTAL_TOKEN
#   Token da API do portal para o utilizador de serviço "ingestao" (TP4).
#   Só se consegue obter DEPOIS de o portal estar a correr e a base de dados povoada:
#     docker compose up -d --build sivitDB portal
#     docker compose exec portal python manage.py seed_sivit --leituras 2000
#   e depois:
#     Linux / macOS / Git Bash:   ./tp4/inicial/criar_token.sh
#     PowerShell (Windows):
#       docker compose exec -T portal python manage.py shell -c "from django.contrib.auth import get_user_model; from rest_framework.authtoken.models import Token; u,_=get_user_model().objects.get_or_create(username='ingestao'); print(Token.objects.get_or_create(user=u)[0].key)"
#   Colar o valor impresso (40 caracteres hexadecimais) e recriar a ingestão:
#     docker compose up -d ingestao


# -----------------------------------------------------------------------------
# Serviço de ingestão (TP4)
# -----------------------------------------------------------------------------

# PORTA_INGESTAO
#   Porta do PC onde a ingestão fica acessível (http://localhost:8001).
#   Mudar só se a 8001 já estiver ocupada, ex.: 8002, 9001.

# MODO_VALIDACAO
#   Como a ingestão valida os dispositivos no portal (exercício 3):
#     off      - não valida (funcionamento normal e linha de referência)
#     ingenuo  - chamada síncrona, sem proteções
#     timeout  - desiste ao fim de 500 ms e aceita a leitura sem validação
#     retry    - timeout + até 3 tentativas com backoff exponencial e jitter
#     breaker  - retry + circuit breaker (5 falhas -> deixa de chamar 10 s)
#     cache    - breaker + cache local das respostas durante 60 s
#   Depois de mudar: docker compose up -d ingestao


# -----------------------------------------------------------------------------
# Portal (TP2 / TP4)
# -----------------------------------------------------------------------------

# LATENCIA_MS
#   Atraso artificial, em milissegundos, em TODAS as respostas do portal.
#     0     - funcionamento normal
#     3000  - experiência da falha em cascata (exercício 3 do TP4)
#   Depois de mudar: docker compose up -d portal


# =============================================================================
# PRONTO A COPIAR para o .env (Windows; no Linux/macOS trocar ; por : no COMPOSE_FILE)
# =============================================================================

COMPOSE_FILE=docker-compose.yml;tp4/inicial/docker-compose.override.yml;tp1/docker-compose.yml
COMPOSE_PROJECT_NAME=tp2etp3
POSTGRES_PASSWORD= (VER EXPLICAÇÃO ACIMA)
DJANGO_SECRET_KEY= (VER EXPLICAÇÃO ACIMA)
PORTAL_TOKEN= (VER EXPLICAÇÃO ACIMA)
PORTA_INGESTAO=8001
MODO_VALIDACAO=off
LATENCIA_MS=0
