COMPOSE_FILE=docker-compose.yml;tp5/inicial/docker-compose.override.yml;tp1/docker-compose.yml
COMPOSE_PROJECT_NAME=tp2etp3
POSTGRES_PASSWORD=devpass
DJANGO_SECRET_KEY=insecure-dev-key-for-testing-12345
PORTAL_TOKEN=placeholder_token_run_criar_token_later
PORTA_INGESTAO=8001
MODO_VALIDACAO=off
LATENCIA_MS=0
# TP5
RABBITMQ_PASSWORD=devpass
PORTA_BROKER=15672
# 1 publica na fila; 0 escreve direto na BD (comportamento de TP4), para comparar
POR_FILA=1
# Publisher confirms: 1 dá garantia de gravação no broker, 0 mede o seu custo
CONFIRMS=1
# Consumidores: os botões das experiências
PREFETCH=10
ACK_AUTOMATICO=0
TRABALHO_MS=0
SEM_ON_CONFLICT=0
MAX_MENSAGENS=100000
POLITICA_CHEIA=reject-publish
